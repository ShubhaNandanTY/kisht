# Postgres connection string. Leave empty to use the embedded local database (PGlite, stored in .data/).
DATABASE_URL=
# Secret used to sign session cookies. Any long random string (openssl rand -base64 32).
SESSION_SECRET=
# Optional. When set, reminder drafts are personalised by Claude; otherwise approved templates are filled directly.
ANTHROPIC_API_KEY=
# Shared secret Vercel Cron sends as a Bearer token to /api/cron/reminders.
CRON_SECRET=
# "true" shows demo logins and the demo clock (lets a reviewer test the 8 am to 7 pm contact block at any hour).
DEMO_MODE=true
